.activity-card{display:block;width:100%;box-sizing:border-box;text-align:left;white-space:normal;margin:24rpx 0;padding:28rpx;background:#fff;border:1rpx solid #dce6df;border-radius:20rpx;line-height:1.6;color:#194f43}.activity-card::after{border:0}.activity-label{font-size:24rpx;color:#7b877f}.activity-title{font-size:32rpx;margin:10rpx 0}.activity-description{font-size:26rpx;color:#61756b}.activity-body{white-space:pre-wrap;line-height:1.8;word-break:break-word}.section-title{margin-top:24rpx}
