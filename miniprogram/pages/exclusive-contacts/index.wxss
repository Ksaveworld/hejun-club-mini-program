.contacts-page{padding:40rpx 32rpx 64rpx;background:#f6f7f1;min-height:100vh;box-sizing:border-box;color:#183f35}.heading{font-size:44rpx;line-height:1.5}.muted,.service-time,.notice{font-size:28rpx;color:#758178;line-height:1.7}.service-time{margin:28rpx 0 18rpx}.contact-card{background:#fff;border:1rpx solid #e3e6de;border-radius:20rpx;padding:28rpx;margin-bottom:24rpx}.contact-role{font-size:30rpx;color:#9c813e}.contact-name{font-size:36rpx;font-weight:600;margin-top:12rpx}.contact-phone{font-size:30rpx;margin:14rpx 0 20rpx}.call-button{background:#194e40;color:#fff;font-size:28rpx;border-radius:12rpx}.status,.error{padding:24rpx;margin:24rpx 0;font-size:28rpx;line-height:1.7}.error{background:#fff0e8;color:#944c32;border-radius:12rpx}.retry{margin-top:24rpx;background:#fff;color:#194e40;font-size:28rpx}.notice{margin-top:24rpx}

.membership-action{margin-top:24rpx;padding:20rpx 24rpx;background:#194e40;color:#fff;font-size:28rpx;line-height:1.6;white-space:normal;border-radius:12rpx}
