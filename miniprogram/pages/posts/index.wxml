<view class="page posts-page">
  <view class="heading"><view class="page-title serif">{{mode === 'feed' ? '会员交流' : mode === 'new' ? '写一篇稿件' : mode === 'edit' ? '修改稿件' : mode === 'detail' ? '稿件与审核结果' : '我的投稿'}}</view><view class="subtitle">提交行业观察与跨境经验，查看自己的稿件和审核结果。</view></view>
  <view wx:if="{{error}}" class="posts-error">{{error}}</view>
  <view wx:if="{{message}}" class="posts-message">{{message}}</view>
  <view wx:if="{{loading}}" class="posts-loading">正在读取会籍与稿件…</view>
  <view wx:if="{{!loggedIn && !loading}}" class="card posts-guest"><view>登录后可查看自己的稿件。</view><button class="primary-action" bindtap="openLogin">登录后查看</button></view>
  <view wx:if="{{ready && !canSubmit && mode !== 'feed'}}" class="card access-note"><view>{{accessNote}}</view><button class="secondary-action" bindtap="openMembers">查看会员权益</button></view>
  <view wx:if="{{ready && canSubmit && (mode === 'new' || mode === 'edit')}}" class="card post-form">
    <view class="section-title serif">{{mode === 'edit' ? '修改稿件并送审' : '写一篇稿件'}}</view>
    <view wx:if="{{mode === 'edit'}}" class="review-note">当前修改基于版本 {{editRevision}}。修改稿通过后才公开；如已有公开版本，新稿通过前会保留。</view>
    <label class="field-label" for="post-title">标题</label>
    <input id="post-title" class="post-input" value="{{title}}" maxlength="60" placeholder="用一句话说明主题" disabled="{{busy || loading || pendingEdit}}" data-field="title" bindinput="changeField" />
    <view class="field-count">{{title.length}} / 60</view>
    <label class="field-label" for="post-body">正文</label>
    <textarea id="post-body" class="post-body" value="{{body}}" maxlength="2000" placeholder="分享你的观察、经验或观点" disabled="{{busy || loading || pendingEdit}}" data-field="body" bindinput="changeField" />
    <view class="field-count">{{body.length}} / 2000</view>
    <view class="footnote">提交后由运营审核，通过后公开；请确认文字为本人原创或已获授权。</view>
    <view wx:if="{{draftNote}}" class="footnote">{{draftNote}}</view>
    <button class="primary-action submit-post" disabled="{{busy || loading}}" loading="{{busy}}" bindtap="submit">{{busy ? '正在保存…' : pendingEdit ? '重试确认本次修改' : mode === 'edit' ? '提交修改稿审核' : '提交审核'}}</button>
    <button wx:if="{{mode === 'edit' && !pendingEdit}}" class="secondary-action" disabled="{{busy || loading}}" bindtap="reloadEdit">放弃本机修改，读取最新稿</button>
  </view>
  <view wx:if="{{ready && (mode === 'list' || mode === 'feed')}}" class="section">
    <button wx:if="{{canSubmit}}" class="primary-action" bindtap="newPost">写一篇稿件</button>
    <view class="section-heading"><view class="section-title serif">{{mode === 'feed' ? '会员交流' : '我的稿件'}}</view><text class="muted">{{posts.length}} 篇</text></view>
    <view wx:if="{{!posts.length}}" class="card posts-empty">{{mode === 'feed' ? '暂无已发布交流内容。' : '还没有提交过稿件。'}}</view>
    <view wx:for="{{posts}}" wx:key="id" class="card post-item"><button class="post-row" data-post-id="{{item.id}}" bindtap="navigatePost"><view class="post-title">{{item.title}}</view><view class="post-meta"><text>{{item.statusLabel}}</text><text>{{item.createdLabel}}</text></view><view class="post-expand">查看稿件与审核结果 ›</view></button></view>
  </view>
  <view wx:if="{{ready && mode === 'detail' && selectedPost}}" class="card post-detail">
    <view class="section-title serif">{{selectedPost.title}}</view><view class="muted">{{selectedPost.reviewStateLabel}} · {{selectedPost.revisionLabel}}</view><text class="post-text" selectable>{{selectedPost.body}}</text>
    <view wx:if="{{selectedPost.status === 'pending'}}" class="review-note">稿件已收到，审核结果会保留在这里。</view>
    <view wx:if="{{selectedPost.reason}}" class="review-note">审核说明：{{selectedPost.reason}}</view>
    <button wx:if="{{!feed && canSubmit && selectedPost.canEdit}}" class="primary-action submit-post" disabled="{{busy || loading}}" bindtap="editPost">修改本人稿件并送审</button>
    <view wx:if="{{!feed && !selectedPost.versioning && selectedPost.status === 'rejected'}}" class="footnote">修改复审尚未初始化，请先查看本次审核说明。</view>
    <view wx:if="{{selectedPost.publishedVersion && selectedPost.publishedVersion.revision !== selectedPost.revision}}" class="review-note"><view class="section-title">目前仍公开的版本 {{selectedPost.publishedVersion.revision}}</view><view>{{selectedPost.publishedVersion.title}}</view><text class="post-text" selectable>{{selectedPost.publishedVersion.body}}</text></view>
    <view wx:if="{{!feed && selectedPost.versions.length}}" class="post-history"><view class="section-title">版本与审核记录</view><view wx:for="{{selectedPost.versions}}" wx:key="revision" class="review-note"><view>版本 {{item.revision}} · {{item.statusLabel}}</view><view>{{item.title}}</view><text class="post-text" selectable>{{item.body}}</text><view wx:if="{{item.reviewedLabel}}">审核时间：{{item.reviewedLabel}}</view><view wx:if="{{item.reason}}">审核说明：{{item.reason}}</view></view></view>
    <button class="secondary-action" bindtap="backToList">返回上一页</button>
  </view>
  <button wx:if="{{error}}" class="secondary-action refresh-posts" disabled="{{loading || busy}}" loading="{{loading}}" bindtap="refreshPosts">重新读取稿件</button>
</view>
