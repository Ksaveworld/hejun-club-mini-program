.steps{margin-top:30rpx}.step{display:flex;gap:18rpx;margin-top:24rpx;align-items:flex-start}.number{flex-shrink:0;width:42rpx;line-height:42rpx;border-radius:50%;background:#f5edda;color:#796331;text-align:center}.notice{margin:26rpx 0;padding:24rpx;border-radius:14rpx;background:#f6edd9;color:#675536;font-size:25rpx}.application-page .secondary-action{margin-top:24rpx}.contact{margin:12rpx 0;color:#697970;font-size:24rpx;text-align:center}.application-page .footnote{margin-top:18rpx}
.upload-card{margin-top:28rpx}.field{margin:24rpx 0;font-size:28rpx}.field input,.field textarea{box-sizing:border-box;width:100%;margin-top:12rpx;padding:20rpx;background:#f5f7f3;border:1rpx solid #dce3dd;border-radius:12rpx}.field input{height:88rpx}.field textarea{min-height:100rpx}.application-page checkbox-group{margin:24rpx 0;font-size:25rpx;line-height:1.7}.selected-file{padding:22rpx;margin:18rpx 0;background:#eef4ef;border-radius:12rpx;word-break:break-all}.submission{padding:24rpx 0;border-bottom:1rpx solid #e8ece8;word-break:break-all}.success{color:#175a46;font-size:34rpx;margin:20rpx 0}.application-page .muted{font-size:25rpx;line-height:1.7;color:#66766c}.legal-link{margin:14rpx 0;font-size:25rpx;color:#1b5746;background:transparent}
