.profile-page { padding: 36rpx; }
.profile-note { color:#697970;font-size:25rpx;line-height:1.8;margin:24rpx 0; }
.profile-error { color:#9d4534;background:#fff0e7;padding:24rpx;margin:24rpx 0; }
.avatar-button { width:160rpx;height:160rpx;border-radius:80rpx;padding:0;margin:24rpx auto; }
.profile-avatar,.profile-empty { width:160rpx;height:160rpx; }
.profile-empty { line-height:160rpx;font-size:26rpx;background:#eaf0e8; }
.profile-label { margin-top:32rpx;padding-top:28rpx;border-top:1rpx solid #e8ede8; }
.profile-input { height:90rpx;padding:12rpx 24rpx;background:#f7f9f6;border:1rpx solid #dfe6e0;margin:16rpx 0 12rpx;border-radius:12rpx;font-size:27rpx; }
.profile-save { background:#174c40;color:#fff;border-radius:14rpx;font-size:29rpx; }
.profile-panel { padding:32rpx;background:#fff;border:1rpx solid #dfe6e0;border-radius:24rpx; }
.profile-step { color:#174c40;font-size:29rpx;font-weight:600; }
.profile-hint { color:#697970;font-size:24rpx;line-height:1.7;text-align:center; }
.profile-remove { display:block;width:180rpx;margin:16rpx auto 0;color:#697970;background:transparent;font-size:24rpx; }
.profile-remove::after,.profile-back::after { border:0; }
.profile-nickname-hint { text-align:left;margin-bottom:32rpx; }
.profile-back { background:transparent;color:#174c40;font-size:28rpx; }
