<view class="page directory-page">
 <view wx:if="{{selected}}">
  <button class="dir-back" bindtap="back">‹ 返回专业服务</button>
  <view class="dir-hero"><view class="dir-eyebrow">专业服务 / 0{{selected.id}}</view><view class="dir-title serif">{{selected.title}}</view><view class="dir-intro">{{selected.summary}}</view><view class="dir-eyebrow">{{selected.details.length}} 项服务模块</view></view>
  <view class="dir-jumps"><button wx:for="{{selected.details}}" wx:key="id" data-id="{{item.id}}" bindtap="jumpModule">{{item.title}}</button></view>
  <view wx:for="{{selected.details}}" wx:key="id" id="module-{{item.id}}" class="dir-module"><view class="dir-eyebrow">模块 0{{item.id}}</view><view class="dir-module-title">{{item.title}}</view><view class="dir-label">服务说明</view><text class="dir-body" selectable>{{item.description}}</text><view class="dir-value"><view class="dir-label">解决问题与价值</view><text class="dir-body" selectable>{{item.value}}</text></view></view>
  <view class="subtitle">具体服务范围、承接方式及费用，以实际对接约定为准。</view>
  <button class="secondary-action" bindtap="openHelp">了解详情与办理服务（星级会员尊享优惠） ›</button>
 </view>
 <view wx:else><view class="dir-eyebrow">连接企业 · 发现专业能力</view><view class="page-title serif">专业服务体系</view><view class="subtitle">从业务需求出发，找到跨境经营所需的支持。</view>
  <view class="dir-tabs"><button data-tab="services" class="{{tab==='services'?'active':''}}" bindtap="changeTab">专业服务</button><button data-tab="partners" class="{{tab==='partners'?'active':''}}" bindtap="changeTab">专业合作</button></view>
  <view wx:if="{{tab==='services'}}"><input class="dir-search" value="{{query}}" bindinput="search" placeholder="搜索服务，如法律、物流、培训" maxlength="50" confirm-type="search"/><button class="secondary-action" bindtap="openProfessionalMaterials">专业服务资料 ›</button><view class="section-title">专业服务体系</view><button wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="openCategory" class="dir-card"><view class="dir-eyebrow">专业服务 <text>0{{item.id}}</text></view><view class="dir-module-title">{{item.title}}</view><view class="dir-summary">{{item.summary}}</view><view class="dir-card-bottom">{{item.modules.length}}项服务 · 查看介绍 <text>↗</text></view></button><view wx:if="{{!filtered.length}}" class="dir-empty"><view>没有找到相关服务，请换个关键词。</view><button class="text-action" bindtap="clearSearch">清空搜索</button></view></view>
  <view wx:else class="partner-panel">
   <view class="dir-card"><view class="dir-module-title">专业合作服务机构</view><view class="dir-summary">专业服务合作伙伴资料待补充，后续将在这里展示各类专业合作服务机构。</view><view class="subtitle">具有跨境专业服务能力的机构，可通过下方入口了解申请要求并提交材料。</view></view>
   <button class="primary-action" bindtap="openPartnerApplication">专业服务合作伙伴申请 ›</button>
   <button data-tab="services" class="text-action" bindtap="changeTab">浏览专业服务</button>
  </view>
 </view>
</view>
