.dir-eyebrow{font-size:22rpx;color:#9b895d;letter-spacing:2rpx;margin:20rpx 0}.dir-tabs{display:flex;border-bottom:1rpx solid #dce3dc;margin:25rpx 0 35rpx}.dir-tabs button{background:none;border-radius:0;font-size:28rpx;margin:0 35rpx 0 0;padding:12rpx 0;color:#7b867d}.dir-tabs button::after,.dir-back::after{border:0}.dir-tabs .active{border-bottom:5rpx solid #205440;color:#205440}.dir-card{background:white;text-align:left;padding:34rpx;margin:24rpx 0;border:1rpx solid #e0e6dd;border-radius:26rpx;line-height:1.7}.dir-card::after{border:0}.dir-eyebrow text,.dir-card-bottom text{float:right}.dir-module-title{font-size:34rpx;font-weight:600;line-height:1.6;margin:20rpx 0}.dir-summary{font-size:25rpx;color:#7a857e;margin-bottom:28rpx}.dir-card-bottom{border-top:1rpx solid #edf0e8;font-size:24rpx;padding-top:25rpx}.dir-hero{background:#174c3d;color:white;padding:35rpx;border-radius:28rpx;margin:24rpx 0}.dir-title{font-size:45rpx;line-height:1.5}.dir-intro{font-size:26rpx;line-height:1.9;color:#dce7de;margin:24rpx 0}.dir-module{background:white;padding:32rpx;border-radius:24rpx;margin:24rpx 0}.dir-label{font-size:27rpx;font-weight:600;margin-bottom:18rpx}.dir-body{font-size:27rpx;line-height:2;color:#657269;white-space:pre-wrap}.dir-value{background:#f7f7ef;border-left:5rpx solid #c8ae6b;padding:25rpx;margin-top:30rpx}.dir-back{background:none;text-align:left;font-size:26rpx;padding:0}.dir-empty{text-align:center;padding:60rpx 24rpx}.dir-empty button{margin-top:30rpx}
.dir-search{height:90rpx;padding:20rpx 24rpx;border:1rpx solid #dce3dc;border-radius:12rpx;background:white;margin-bottom:28rpx}.dir-jumps{display:flex;flex-wrap:wrap;gap:14rpx}.dir-jumps button{padding:12rpx 18rpx;border:1rpx solid #dce3dc;border-radius:10rpx;font-size:24rpx}
.dir-company-card{overflow-wrap:anywhere}.dir-article-action{background:none;text-align:left;padding:18rpx 0 0;margin:0;border-top:1rpx solid #edf0e8;border-radius:0;color:#205440;font-size:26rpx}.dir-article-action::after{border:0}.dir-article-notice{margin-top:22rpx;padding:22rpx;background:#f7f7ef;border-radius:12rpx;color:#657269;font-size:25rpx;line-height:1.8}.dir-article-notice button{margin:14rpx 0 0;text-align:left;padding:0;color:#205440}
