.invite-preview { display:flex; flex-direction:column; gap:24rpx; }
.invite-card-image, .invite-poster-image { display:block; width:100%; border-radius:12rpx; }
.invite-preview .section-title { margin-top:20rpx; }
.invite-error, .invite-message { padding:22rpx; margin:20rpx 0; border-radius:12rpx; background:#fff0df; color:#804724; }
.invite-message { background:#e4eee6; color:#164c3d; }
.retry-invite { margin-top:26rpx; }
.export-canvas { position:fixed; left:-1200px; top:0; pointer-events:none; }
.card-canvas { width:600px; height:480px; }
.poster-canvas { width:600px; height:900px; }
