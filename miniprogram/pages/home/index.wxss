.brand-row { display: flex; align-items: center; margin: 0 0 26rpx; }
.brand-logo { display: block; width: 324rpx; }
.brand-label { padding-left: 22rpx; color: #697970; font-size: 24rpx; }
.hero { position: relative; overflow: hidden; padding: 44rpx 34rpx 42rpx; border-radius: 18rpx; background: #164c3d; color: #f8efce; }
.hero-title { position: relative; z-index: 1; font-size: 47rpx; line-height: 1.65; letter-spacing: 2rpx; }
.hero-subtitle { position: relative; z-index: 1; margin-top: 22rpx; color: #d5dec7; font-size: 22rpx; }
.hero-line { position: absolute; width: 400rpx; height: 400rpx; border: 1rpx solid #638568; border-radius: 50%; opacity: 0.35; }
.hero-line-one { right: -270rpx; top: -160rpx; }
.hero-line-two { right: -210rpx; top: -100rpx; }
.shortcuts { display: flex; margin-top: 24rpx; padding: 22rpx 6rpx; border-radius: 16rpx; background: #ffffff; }
.shortcut { width: 25%; font-size: 23rpx; text-align: center; }
.shortcut-mark { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; margin: 0 auto 14rpx; border: 1rpx solid #d9bb72; border-radius: 50%; background: #fffae9; color: #164c3d; font-size: 35rpx; }
.editorial { display: block; padding: 26rpx 28rpx 20rpx; border: 1rpx solid #d7b96c; border-left: 5rpx solid #c9a956; border-radius: 12rpx; background: #ffffff; }
.editorial-kicker { color: #758479; font-size: 22rpx; }
.editorial-title { margin-top: 10rpx; font-size: 32rpx; }
.editorial-copy { margin-top: 10rpx; color: #697970; font-size: 25rpx; line-height: 1.9; }
.editorial-status { display: flex; justify-content: space-between; margin-top: 20rpx; color: #7c8b81; font-size: 22rpx; }
.guide { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; }
.guide-title { font-size: 30rpx; }
.guide-copy { margin-top: 8rpx; color: #697970; font-size: 25rpx; }
.membership-banner { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 28rpx; border: 1rpx solid #e4c979; border-radius: 12rpx; background: #f8edc9; }
.all-services { padding: 28rpx 0 12rpx; color: #287963; text-align: center; font-size: 26rpx; }

.journey-summary { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-top:24rpx; padding:28rpx; }
.editorial + .editorial { margin-top:18rpx; }

.campaign-mask{position:fixed;inset:0;z-index:1000;background:#102b2388;display:flex;align-items:center;justify-content:center;padding:35rpx}.campaign-panel{position:relative;box-sizing:border-box;max-height:90vh;overflow-y:auto;width:650rpx;padding:55rpx 42rpx 35rpx;border-radius:36rpx;background:#174c3d;color:white}.campaign-close{position:absolute;right:18rpx;top:10rpx;color:#d4e2d5;background:none;font-size:44rpx}.campaign-close::after,.campaign-later::after{border:0}.campaign-kicker{font-size:20rpx;color:#d4c28a;letter-spacing:3rpx}.campaign-date{font-size:85rpx;font-family:serif;color:#ddcc96;margin:35rpx 0 20rpx}.campaign-title{font-size:45rpx;white-space:pre-line;line-height:1.5}.campaign-copy{font-size:26rpx;color:#dbe5d8;white-space:pre-line;margin:24rpx 0;line-height:1.8}.campaign-meta{font-size:23rpx;color:#aec1b0;white-space:pre-line;margin:25rpx 0;line-height:1.9}.campaign-choice{font-size:27rpx;background:#e4d29e;color:#214837;text-align:left;border-radius:16rpx;margin:16rpx 0;padding:8rpx 22rpx}.campaign-demand{background:#ffffff10;color:#e7ecdc;border:1rpx solid #718879}.campaign-later{font-size:25rpx;background:none;color:#c4d2c2}.campaign-note{font-size:19rpx;text-align:center;color:#acbda8}