.search-row { display: flex; align-items: center; gap: 16rpx; min-height: 92rpx; padding: 0 24rpx; border: 1rpx solid #dfe6e0; border-radius: 12rpx; background: #ffffff; }
.search-icon { flex-shrink: 0; width: 40rpx; height: 40rpx; }
.search-input { flex: 1; min-width: 0; height: 92rpx; color: #203c32; font-size: 28rpx; }
.clear-search { flex-shrink: 0; min-height: 80rpx; padding: 16rpx 0 16rpx 12rpx; color: #287963; font-size: 25rpx; }
.result-count { margin-top: 18rpx; color: #697970; font-size: 24rpx; }
.card { margin-top: 24rpx; }
.card .secondary-action { margin-top: 18rpx; }
.service-section { margin-top: 30rpx; }
.group-title { margin-bottom: 8rpx; color: #164c3d; font-size: 34rpx; font-weight: 600; }
.group-summary { margin-bottom: 16rpx; color: #697970; font-size: 24rpx; line-height: 1.7; }
.service-list { padding: 0 24rpx; border-radius: 18rpx; background: #ffffff; }
.service-list-professional { background: #fffaf0; border: 1rpx solid #e3ca8e; }
.service-item { display: flex; align-items: center; gap: 18rpx; width: 100%; min-height: 126rpx; padding: 24rpx 0; border-bottom: 1rpx solid #edf1eb; }
.service-item:last-child { border-bottom: 0; }
.service-icon-tile { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 76rpx; height: 76rpx; }
.service-icon { display: block; width: 58rpx; height: 58rpx; }
.service-copy { flex: 1; min-width: 0; word-break: break-all; }
.service-category { margin-top: 5rpx; color: #8a794c; font-size: 22rpx; }
.service-title { font-size: 32rpx; line-height: 1.6; font-weight: 500; }
.service-summary { margin-top: 6rpx; color: #697970; font-size: 24rpx; line-height: 1.75; }
.arrow { display: flex; align-items: center; justify-content: center; flex: 0 0 28rpx; width: 28rpx; height: 40rpx; padding-left: 0; color: #697970; font-size: 34rpx; line-height: 1; }
.empty-state { padding: 48rpx 24rpx; text-align: center; }
.empty-icon { width: 76rpx; height: 76rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 34rpx; }
.empty-copy { margin-top: 14rpx; color: #697970; font-size: 26rpx; }
.empty-state .secondary-action { margin: 30rpx auto 0; width: 260rpx; }
.membership-action { margin-top: 32rpx; }
@media (max-width: 380px) {
  .service-list { padding-left: 18rpx; padding-right: 18rpx; }
  .service-item { gap: 12rpx; }
  .service-icon-tile { width: 64rpx; }
}
