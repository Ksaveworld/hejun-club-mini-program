.feedback-form, .feedback-detail, .feedback-item { margin:24rpx 0; }
.feedback-form { display:flex; flex-direction:column; gap:20rpx; }
.feedback-input { width:100%; min-height:80rpx; padding:18rpx; border:1rpx solid #d5dfd5; border-radius:10rpx; background:#fafbf7; }
.feedback-body { height:260rpx; box-sizing:border-box; }
.feedback-text { display:block; white-space:pre-wrap; word-break:break-all; margin:18rpx 0; }
.feedback-event { border-top:1rpx solid #d5dfd5; margin-top:24rpx; padding-top:24rpx; }
.feedback-error, .feedback-message { padding:20rpx; margin-bottom:20rpx; background:#fff0df; color:#804724; border-radius:12rpx; }
.feedback-message { background:#e4eee6; color:#164c3d; }

.feedback-followup { margin-top: 28rpx; } .feedback-unread { color: #a76524; font-size: 24rpx; } .feedback-followup .secondary-action { margin-top: 16rpx; }
